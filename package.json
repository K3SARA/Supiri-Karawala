{
  "name": "supiri-karawala",
  "version": "1.0.13",
  "description": "Offline Supiri Karawala POS Software",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/launch-electron.js",
    "dev": "node scripts/launch-electron.js --dev",
    "build:web": "node scripts/build-web.js",
    "start:web": "node server.js",
    "serve:web": "npx serve web-dist",
    "dist": "electron-builder --win nsis",
    "build:android": "npm run build:web && npx cap sync android",
    "open:android": "npx cap open android"
  },
  "author": "Supiri Karawala",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "chart.js": "^4.4.7",
    "dexie": "^3.2.7",
    "jsbarcode": "^3.11.6",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.supirikarawala.pos",
    "productName": "Supiri Karawala",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
